# E-Chowk backend environment template
# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Public HTTPS URL used by Twilio webhooks.
# Local example: https://YOUR-NGROK-DOMAIN.ngrok-free.dev
PUBLIC_BASE_URL=

# AI
GROQ_API_KEY=

# Optional application settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# Authentication
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# AI
GROQ_AGENT_MODEL=openai/gpt-oss-20b
