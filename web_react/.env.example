# E-Chowk Web Frontend Environment Configuration

# Backend API endpoint (leave empty for same-origin proxy in development)
VITE_API_URL=https://echowk-dev-api.azurewebsites.net

# Firebase Phone Auth (Google Identity Platform - 10,000 free SMS/month)
# Get these free keys from: https://console.firebase.google.com -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
